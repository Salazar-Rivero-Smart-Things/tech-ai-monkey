{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Check Auth config presence",
			"type": "shell",
			"command": "awk",
			"args": [
				"-F=",
				"/^[A-Za-z_][A-Za-z0-9_]*=/ { print $1 \"=\" (length($0) > length($1) + 1 ? \"set\" : \"empty\") }",
				".env.local"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Build web production",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": [
				"$tsc"
			]
		}
	]
}