# ---- Database (Neon Postgres via Vercel Marketplace) ----
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# ---- Auth.js ----
# Generate: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---- Encryption key for secrets at rest (32 bytes, base64) ----
# Protects connected-app OAuth tokens (Google, Slack) in the database.
# Generate: openssl rand -base64 32
# The older name SSN_KEK still works as a fallback.
SECRET_KEK=
SSN_KEK=

# ---- Owner access (unlimited, no paywall) ----
# Accounts with role "admin" are unlimited automatically (the first account
# ever created is promoted to admin). List extra e-mails here as a safety net.
OWNER_EMAILS=

# ---- Connected apps (Apps to connect) ----
# OAuth apps for the "Apps to connect" page. Register this redirect URI:
#   <NEXT_PUBLIC_APP_URL>/api/integrations/<provider>/callback
# Google falls back to AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET when left empty.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Stripe (cards + Apple Pay + Google Pay) ----
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe Price IDs for each subscription plan (create in the Stripe dashboard)
STRIPE_PRICE_PRO=
STRIPE_PRICE_ULTRA=
STRIPE_PRICE_BOMB=

# ---- PayPal ----
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox | live
PAYPAL_ENV=sandbox

# ---- Crypto (direct-to-wallet, self-custody) ----
# Your own wallet addresses; payments arrive here directly (no processor).
CRYPTO_BTC_ADDRESS=
CRYPTO_ETH_ADDRESS=
CRYPTO_BCH_ADDRESS=
# Optional: block explorer API keys for on-chain verification
# BLOCKCHAIR_API_KEY=   # BTC / BCH
# ETHERSCAN_API_KEY=    # ETH / ERC-20

# ---- App ----
NEXT_PUBLIC_APP_URL=https://tech-ai.tech

# ---- AI agent (the eve backend the web app proxies chat to) ----
# URL of the deployed agent, e.g. https://my-ai-agent.vercel.app
EVE_AGENT_URL=http://127.0.0.1:2000
# MUST be the SAME value as the agent's AGENT_API_KEY_SECRET (both sides).
AGENT_API_KEY_SECRET=

# ---- Active AI model (shown in the banner) ----
MODEL_NAME=Monkey
MODEL_VERSION=v1

# ---- Company / legal ----
COMPANY_NAME=Salazar Rivero Smart Things
ORGANIZATION_NUMBER=933 853 195

# ---- Customer support ----
SUPPORT_EMAIL=support@tech-ai.tech
SUPPORT_WHATSAPP_URL=https://wa.me/4748904267
SUPPORT_HOURS=12:00-21:00 every day

