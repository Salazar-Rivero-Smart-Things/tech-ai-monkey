# Shared secret used to mint and verify API keys (bearer JWTs).
# REQUIRED for the "give me an API key" tool and for production route auth.
# Use a long random string, e.g. output of: openssl rand -hex 32
AGENT_API_KEY_SECRET=change-me-to-a-long-random-string

# Base URL the agent uses to reach its own HTTP control routes
# (used by the delete_chat_history tool). Defaults to http://127.0.0.1:2000.
EVE_PUBLIC_URL=http://127.0.0.1:2000

# Only needed if you switch agent/agent.ts to a direct provider model helper
# (anthropic() / openai()) instead of a Vercel AI Gateway model string.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# DeepSeek (direct). agent/agent.ts uses this when set — keep the real value in
# .env only (git-ignored), never here.
# DEEPSEEK_API_KEY=
