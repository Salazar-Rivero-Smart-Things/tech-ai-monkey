# Shared secret used to mint and verify API keys (bearer JWTs).
# REQUIRED for the "give me an API key" tool and for production route auth.
# Use a long random string, e.g. output of: openssl rand -hex 32
AGENT_API_KEY_SECRET=change-me-to-a-long-random-string

# Base URL the agent uses to reach its own HTTP control routes
# (used by the delete_chat_history tool). Defaults to http://127.0.0.1:2000.
EVE_PUBLIC_URL=http://127.0.0.1:2000

# Only needed if you switch agent/agent.ts to a direct provider model helper
# (anthropic() / openai()) instead of a Vercel AI Gateway model string.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Model selection (first one configured wins) ----------------------------
# 1) Vercel AI Gateway — one key, 400+ models, including "-fast" variants.
#    List models: curl -s https://ai-gateway.vercel.sh/v1/models
#    AGENT_MODEL=openai/gpt-5.4-fast
#    AI_GATEWAY_API_KEY=...        (or VERCEL_OIDC_TOKEN via `vercel env pull`)

# 2) Any OpenAI-compatible provider (Groq, Cerebras, OpenRouter, Together, vLLM …).
#    Set these three:
#    OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
#    OPENAI_COMPAT_MODEL=llama-3.3-70b-versatile
#    OPENAI_COMPAT_API_KEY=gsk_...
#    OPENAI_COMPAT_CONTEXT_TOKENS=131072
#    OPENAI_COMPAT_NAME=groq

# 3) Local Ollama (shortcut). Ollama ignores the key, but the client needs one.
#    OLLAMA_MODEL=llama3.1:8b
#    OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
#    OLLAMA_API_KEY=ollama
#    OLLAMA_CONTEXT_TOKENS=8192

# 4) DeepSeek (direct). Keep the real value in .env only (git-ignored), never here.
#    DEEPSEEK_API_KEY=

# 5) Nothing set -> free fallback (poolside/laguna-s-2.1-free) via AI Gateway.
#
# Tip: measure speed/tool-support before choosing:  npm run bench

# --- Learned skills & long-term memory (optional) ---------------------------
# Where skills the agent learns are stored. Defaults to <repo>/skills, with
# skills/global/<slug>.md shared with everyone and skills/users/<id>/<slug>.md
# private. The agent and the web dashboard resolve the same folder themselves.
# EVE_SKILLS_DIR=/absolute/path/to/skills

# Where per-user long-term memories are stored. Defaults to ./.agent-memory.
# EVE_MEMORY_DIR=/absolute/path/to/memory

# --- Persistent sandbox & continuous AI simulation --------------------------
# Prevents Eve from killing/stopping the sandbox VM after each turn, keeping
# all background processes, project files, and agents permanently active.
EVE_DEV=1
EVE_PERSIST_SANDBOX=1

# --- Video analysis (FFmpeg) -------------------------------------------------
# The agent can watch screen recordings and clips: analyze_video runs ffmpeg on
# the server and describes sampled stills with a vision model.
#   1. Install FFmpeg on the server:      sudo apt install ffmpeg
#   2. Drop videos in <repo>/videos/      (or set EVE_VIDEOS_DIR)
#   3. A vision-capable model is required. By default the agent reuses
#      OPENAI_COMPAT_BASE_URL / OPENAI_COMPAT_API_KEY / OPENAI_COMPAT_MODEL;
#      point it somewhere else if that model cannot read images:
# VIDEO_VISION_BASE_URL=https://api.groq.com/openai/v1
# VIDEO_VISION_MODEL=qwen/qwen3.8-27b
# VIDEO_VISION_API_KEY=gsk_...
# Output tokens per request (default 900; free tiers often cap at 1000/min).
# VIDEO_VISION_MAX_TOKENS=900
# EVE_VIDEOS_DIR=/absolute/path/to/videos

# --- AI image generation -----------------------------------------------------
# The agent can create pictures on request (generate_image). Without a key it
# falls back to the free pollinations.ai service, so prompts leave the server.
# Point these at your own OpenAI-compatible image endpoint to keep prompts
# private:
# IMAGE_GEN_BASE_URL=https://api.openai.com/v1
# IMAGE_GEN_API_KEY=sk-...
# IMAGE_GEN_MODEL=gpt-image-1
# Where generated files are written (defaults to web/public/generated):
# EVE_GENERATED_DIR=/absolute/path/to/generated

# --- How long a sandbox command may take -------------------------------------
# A frozen Microsandbox VM used to hang the turn forever. Every sandbox call is
# now bounded; a healthy VM answers in well under a second.
# SANDBOX_COMMAND_TIMEOUT_MS=45000
