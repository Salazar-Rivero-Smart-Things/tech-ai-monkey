# Varsel-oppsett for myai-healthcheck.service.
#
# Kopier til /etc/myai-alert.env (bare root kan lese den):
#   sudo install -m 600 deploy/myai-alert.env.example /etc/myai-alert.env
#
# Velg et langt og hemmelig topic-navn – alle som kjenner navnet kan lese
# varslene. Abonner i ntfy-appen eller på web:
#   https://ntfy.tech-ai.tech/<topic>
NTFY_URL=https://ntfy.tech-ai.tech
NTFY_TOPIC=bytt-til-et-hemmelig-topic-navn

# Portene leses ellers fra PORT= i de installerte unit-filene.
# MYAI_WEB_PORT=3100
# MYAI_AGENT_PORT=2000
