# Valgfri overstyring for den nattlige backupen (deploy/backup-db.sh).
# Kopier til deploy/backup.env (git-ignorert) og endre det du trenger.
# Filen leses av systemd-tjenesten myai-backup.service.

# Hvor backupene lagres. Standard: ~/backups/tech-ai-monkey
# Legg den gjerne på en annen disk enn databasen (f.eks. NAS eller ekstern disk).
# BACKUP_DIR=/mnt/nas/tech-ai-backups

# Hvor mange dager med daglige backuper som beholdes.
# DAILY_KEEP_DAYS=30

# Hvor mange måneder med månedlige backuper som beholdes (tas den 1. hver måned).
# MONTHLY_KEEP_MONTHS=12
