# MyAI – web-app (Next.js, port 3000)
# Kopier til: /etc/systemd/system/myai-web.service
# Deretter: sudo systemctl daemon-reload && sudo systemctl enable --now myai-web
#
# KREVER at web-appen er bygget først:  cd web && npm run build
# Bruker, Gruppe og Node-sti fylles ut automatisk av deploy/install-services.sh.

[Unit]
Description=MyAI web-app (Next.js, port 3000)
After=network-online.target myai-agent.service
Wants=network-online.target

[Service]
Type=simple
User=@@USER@@
Group=@@GROUP@@
WorkingDirectory=@@REPO@@/web
Environment=PATH=@@NODE_BIN@@:/usr/local/bin:/usr/bin:/bin
Environment=PORT=3000
Environment=NODE_ENV=production
ExecStart=@@NODE_BIN@@/npm run start
Restart=always
RestartSec=5
KillMode=mixed

[Install]
WantedBy=multi-user.target
