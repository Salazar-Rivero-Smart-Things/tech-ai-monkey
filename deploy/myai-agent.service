# MyAI – eve-agent (port 2000)
# Kopier til: /etc/systemd/system/myai-agent.service
# Deretter: sudo systemctl daemon-reload && sudo systemctl enable --now myai-agent
#
# Bruker, Gruppe og Node-sti fylles ut automatisk av deploy/install-services.sh.

[Unit]
Description=MyAI eve-agent (port 2000)
After=network-online.target
Wants=network-online.target
# Start aldri å gi opp: krasjer agenten skal den bare starte på nytt, i det
# uendelige. Uten dette gir systemd opp etter 5 feil på 10 s.
StartLimitIntervalSec=0

[Service]
Type=simple
User=@@USER@@
Group=@@GROUP@@
WorkingDirectory=@@REPO@@
Environment=PATH=@@NODE_BIN@@:/usr/local/bin:/usr/bin:/bin
Environment=PORT=2000
Environment=NODE_ENV=production
EnvironmentFile=@@REPO@@/.env
ExecStart=@@NODE_BIN@@/npm run start
Restart=always
RestartSec=3
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
