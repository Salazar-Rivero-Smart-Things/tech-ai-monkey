# Eksempel for agentens hemmeligheter (se roten av prosjektet).
# Kopier innholdet til:  /home/hesriverp7/Dokumenter/MyGits/MyAI/.env.agent
# og fyll inn ekte verdier. Sett filrettigheter:  chmod 600 .env.agent

# Må være SAMME verdi som web/.env.local sin AGENT_API_KEY_SECRET.
AGENT_API_KEY_SECRET=<samme som web/.env.local>

# Din nøkkel fra https://vercel.com/ai-gateway (Dashboard → AI Gateway → API Keys).
AI_GATEWAY_API_KEY=<din gateway-nøkkel>
